<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TransReaderBrandBrush" Color="#3D63DD" />
            <SolidColorBrush x:Key="TransReaderBrandSecondaryBrush" Color="#1A3D63DD" />
            <SolidColorBrush x:Key="TransReaderImageBackdropBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="TransReaderThumbnailSelectionBrush" Color="#223D63DD" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TransReaderBrandBrush" Color="#7C9BFF" />
            <SolidColorBrush x:Key="TransReaderBrandSecondaryBrush" Color="#337C9BFF" />
            <SolidColorBrush x:Key="TransReaderImageBackdropBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="TransReaderThumbnailSelectionBrush" Color="#447C9BFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Corner radius tokens -->
    <CornerRadius x:Key="TransReaderCardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="TransReaderControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TransReaderPillCornerRadius">12</CornerRadius>

    <!-- Spacing tokens -->
    <Thickness x:Key="TransReaderPageMargin">16</Thickness>
    <Thickness x:Key="TransReaderCardPadding">16</Thickness>
    <x:Double x:Key="TransReaderCardSpacing">12</x:Double>

    <!-- Typography tokens -->
    <x:Double x:Key="TransReaderTitleFontSize">20</x:Double>
    <x:Double x:Key="TransReaderSubtitleFontSize">15</x:Double>
    <x:Double x:Key="TransReaderBodyFontSize">16</x:Double>
    <x:Double x:Key="TransReaderBodyLineHeight">30</x:Double>
    <x:Double x:Key="TransReaderCaptionFontSize">12</x:Double>

    <!-- Shared styles -->
    <Style x:Key="TransReaderCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource TransReaderCardCornerRadius}" />
    </Style>

    <Style x:Key="TransReaderSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource TransReaderSubtitleFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TransReaderCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource TransReaderCaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="TransReaderBodyParagraphStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{ThemeResource TransReaderBodyFontSize}" />
        <Setter Property="LineHeight" Value="{ThemeResource TransReaderBodyLineHeight}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>
</ResourceDictionary>
