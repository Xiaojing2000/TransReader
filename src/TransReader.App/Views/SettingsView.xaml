<UserControl
    x:Class="TransReader.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:TransReader.App.Views"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <SolidColorBrush x:Key="StatusNeutralBrush" Color="{ThemeResource TextFillColorSecondary}" />
        <SolidColorBrush x:Key="StatusSuccessBrush" Color="{ThemeResource SystemFillColorSuccess}" />
        <SolidColorBrush x:Key="StatusCautionBrush" Color="{ThemeResource SystemFillColorCaution}" />
    </UserControl.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Padding="16,0,8,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <TextBlock Text="AI 中心"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="10,6"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="返回阅读器">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="16">

                <!-- ============ 总览 ============ -->
                <TextBlock Text="概览" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="OverviewInfoBar" IsClosable="True" IsOpen="False" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前模式" Style="{StaticResource CardTitleStyle}" />
                                <ToggleSwitch x:Name="ModeToggle"
                                              IsOn="True"
                                              OnContent="在线翻译"
                                              OffContent="本地翻译"
                                              Toggled="ModeToggle_Toggled" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="关闭时优先使用本地 Hy-MT2 专业翻译模型（未安装时兼容 Qwen3）；开启时调用「在线 API」页配置的接口。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="活动模型" Style="{StaticResource CardTitleStyle}" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="在线（当前活动端点）" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock x:Name="OverviewOnlineModelName" Text="—" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OverviewOnlineModelMeta" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="本地" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock x:Name="OverviewLocalModelText" Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="用量" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="OverviewUsageText" Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                

                <!-- ============ 在线 API ============ -->
                <TextBlock x:Name="SectionOnline" Text="在线 API" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="OnlineInfoBar" IsClosable="True" IsOpen="False" />
                        <InfoBar IsClosable="False"
                                 IsOpen="True"
                                 Severity="Informational"
                                 Title="模型建议"
                                 Message="建议使用小米 MiMo V2.5 模型，因为支持多模态且单价更实惠。" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="首次启动不预置任何模型。API Key 仅保存到 Windows 凭据库，不写入配置文件，也不会在编辑或 JSON 预览中回显。"
                                   TextWrapping="Wrap" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="ProviderCountText"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   Text="已配置模型" />
                                        <TextBlock x:Name="ProviderSummaryText" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="AddModel_Click"
                                            Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                            <TextBlock Text="添加模型" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ListView x:Name="ProviderList"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                          SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="views:ProviderRowItem">
                                            <Border Padding="14,10"
                                                    Margin="0,0,0,8"
                                                    HorizontalAlignment="Stretch"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Width="10"
                                                                Height="10"
                                                                VerticalAlignment="Center"
                                                                Background="{x:Bind StatusBrush}"
                                                                CornerRadius="5"
                                                                ToolTipService.ToolTip="{x:Bind StatusText}" />
                                                        <TextBlock VerticalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Text="{x:Bind DisplayName}" />
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind IsActive}">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                       Text="活动" />
                                                        </Border>
                                                        <Border Padding="6,1"
                                                                VerticalAlignment="Center"
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="4"
                                                                Visibility="{x:Bind IsCustom}">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                       Text="自定义" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Text="{x:Bind EndpointText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{x:Bind StatusBrush}"
                                                                   Text="{x:Bind StatusText}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   Text="{x:Bind UsageText}"
                                                                   Visibility="{x:Bind HasUsage}" />
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Visibility="{x:Bind HasTestResult}">
                                                            <FontIcon FontSize="12"
                                                                      Foreground="{x:Bind TestResultBrush}"
                                                                      Glyph="{x:Bind TestResultGlyph}" />
                                                            <TextBlock FontSize="12"
                                                                       Text="{x:Bind TestResultText}"
                                                                       ToolTipService.ToolTip="{x:Bind TestResultMessage}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,4,0,0"
                                                                Orientation="Horizontal"
                                                                Spacing="6">
                                                        <Button Content="设为活动"
                                                                IsEnabled="{x:Bind IsNotActive}"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Tag="{x:Bind Id}"
                                                                Click="ProviderSetActive_Click" />
                                                        <Button Content="编辑"
                                                                Tag="{x:Bind Id}"
                                                                Click="ProviderEdit_Click" />
                                                        <Button Content="测试"
                                                                Tag="{x:Bind Id}"
                                                                Click="ProviderTest_Click" />
                                                        <Button Content="删除"
                                                                Tag="{x:Bind Id}"
                                                                Click="ProviderDelete_Click" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 编辑面板：默认收起，点「添加模型」或卡片「编辑」时展开 -->
                        <Border x:Name="ProviderFormCard"
                                Style="{StaticResource CardStyle}"
                                Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="FormTitleText"
                                           Style="{StaticResource CardTitleStyle}"
                                           Text="配置模型" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="供应商模板" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="ProviderTemplateBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="ProviderTemplateBox_SelectionChanged">
                                        <ComboBoxItem Content="小米 MiMo" Tag="mimo" />
                                        <ComboBoxItem Content="Kimi" Tag="kimi" />
                                        <ComboBoxItem Content="智谱 GLM" Tag="glm" />
                                        <ComboBoxItem Content="DeepSeek" Tag="deepseek" />
                                        <ComboBoxItem Content="自定义" Tag="custom" />
                                    </ComboBox>
                                    <HyperlinkButton x:Name="ProviderHomepageButton"
                                                     Padding="0,4"
                                                     Content="打开供应商官网"
                                                     Click="ProviderHomepageButton_Click" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="API 协议" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="ApiProtocolBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="OpenAI Completions" Tag="openai-completions" />
                                    </ComboBox>
                                    <TextBlock Text="适用于提供 OpenAI 兼容 /chat/completions 与 /models 接口的服务。"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="DisplayNameField" Spacing="4">
                                    <TextBlock Text="显示名称" Style="{StaticResource CaptionStyle}" />
                                    <TextBox x:Name="DisplayNameBox"
                                             MinWidth="280"
                                             HorizontalAlignment="Left"
                                             TextChanged="ProviderFormValue_Changed"
                                             PlaceholderText="例如：公司内网网关" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="API 地址（BaseUrl）" Style="{StaticResource CaptionStyle}" />
                                    <TextBox x:Name="BaseUrlBox"
                                             MinWidth="420"
                                             HorizontalAlignment="Left"
                                             TextChanged="ProviderFormValue_Changed"
                                             PlaceholderText="https://api.example.com/v1" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="API Key" Style="{StaticResource CaptionStyle}" />
                                    <PasswordBox x:Name="ApiKeyBox"
                                                 MinWidth="420"
                                                 HorizontalAlignment="Left"
                                                 PasswordChanged="ProviderFormValue_Changed"
                                                 PlaceholderText="请输入 API Key" />
                                    <TextBlock x:Name="ApiKeyStatusText"
                                               Style="{StaticResource CaptionStyle}"
                                               Text="尚未保存；API Key 不会出现在 JSON 中。" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="模型 ID" Style="{StaticResource CaptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="ModelBox"
                                                 MinWidth="320"
                                                 TextChanged="ProviderFormValue_Changed"
                                                 PlaceholderText="输入模型 ID，或先检测模型" />
                                        <Button x:Name="DetectModelsButton"
                                                Content="检测模型"
                                                Click="DetectModels_Click" />
                                    </StackPanel>
                                    <ComboBox x:Name="DetectedModelBox"
                                              MinWidth="420"
                                              HorizontalAlignment="Left"
                                              PlaceholderText="请选择探测到的模型"
                                              SelectionChanged="DetectedModelBox_SelectionChanged"
                                              Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="目标语言" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="ProviderLanguageBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectedIndex="0"
                                              SelectionChanged="ProviderFormValue_Changed">
                                        <ComboBoxItem Content="简体中文" />
                                        <ComboBoxItem Content="繁体中文" />
                                        <ComboBoxItem Content="英语" />
                                        <ComboBoxItem Content="日语" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="输入类型" Style="{StaticResource CaptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <CheckBox Content="text" IsChecked="True" IsEnabled="False" />
                                        <CheckBox x:Name="ImageInputCheckBox"
                                                  Content="image"
                                                  Checked="ProviderFormValue_Changed"
                                                  Unchecked="ProviderFormValue_Changed" />
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch x:Name="ReasoningToggle"
                                              Header="推理模式"
                                              OffContent="关闭"
                                              OnContent="启用"
                                              Toggled="ProviderFormValue_Changed" />
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="配置 JSON"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right"
                                                Content="复制 JSON"
                                                Click="CopyGeneratedJson_Click" />
                                    </Grid>
                                    <TextBox x:Name="GeneratedJsonBox"
                                             MinHeight="260"
                                             AcceptsReturn="True"
                                             FontFamily="Consolas"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                    <TextBlock Text="预览中的 apiKey 始终为空；保存时 Key 单独写入 Windows 凭据库。"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <InfoBar x:Name="ProviderFormStatusBar"
                                         IsClosable="False"
                                         IsOpen="False" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="ProviderSave_Click"
                                            Content="保存"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    <Button x:Name="ProviderFormTestButton"
                                            Click="ProviderFormTest_Click"
                                            Content="测试连接" />
                                    <ProgressRing x:Name="TestConnectionProgressRing"
                                                  Width="20"
                                                  Height="20"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                    <Button Click="ProviderFormCancel_Click"
                                            Content="取消" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                

                <!-- ============ 本地组件 ============ -->
                <TextBlock x:Name="SectionLocal" Text="本地组件" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="LocalInfoBar" IsClosable="True" IsOpen="False" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="OCR 文字识别" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="PaddleOCR PP-OCRv5 mobile · 可选组件" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OcrEnabledToggle"
                                                  HorizontalAlignment="Right"
                                                  OnContent="开启"
                                                  OffContent="关闭"
                                                  Toggled="OcrEnabledToggle_Toggled" />
                                </Grid>
                                <TextBlock x:Name="OcrStatusText" Style="{StaticResource CaptionStyle}" />
                                <ProgressBar x:Name="OcrInstallProgress"
                                             Maximum="1"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="OcrInstalledSizeText" Style="{StaticResource CaptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OcrInstallButton"
                                            Click="OcrInstall_Click"
                                            Content="安装 / 智能修复"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    <Button x:Name="OcrReloadButton" Click="OcrReload_Click" Content="重新载入" />
                                    <Button x:Name="OcrVerifyButton" Click="OcrVerify_Click" Content="校验" />
                                    <Button x:Name="OcrImportButton" Click="OcrImport_Click" Content="导入离线包" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OcrForceButton" Click="OcrForce_Click" Content="强制重新安装" />
                                    <Button x:Name="OcrUninstallButton" Click="OcrUninstall_Click" Content="卸载" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="首次使用时才需要安装，约 112 MB；会在 GitHub 官方源与 ghproxy.net 镜像间自动切换，也可导入发布页提供的离线组件包。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="本地大模型" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock Text="模型按需安装，共用本地推理运行时" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LocalEnabledToggle"
                                                  HorizontalAlignment="Right"
                                                  OnContent="开启"
                                                  OffContent="关闭"
                                                  Toggled="LocalEnabledToggle_Toggled" />
                                </Grid>
                                <ComboBox x:Name="LocalModelPicker"
                                          MinWidth="360"
                                          HorizontalAlignment="Left"
                                          SelectionChanged="LocalModelPicker_SelectionChanged" />
                                <TextBlock x:Name="LocalStatusText" Style="{StaticResource CaptionStyle}" />
                                <ProgressBar x:Name="LocalInstallProgress"
                                             Maximum="1"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="LocalInstalledSizeText" Style="{StaticResource CaptionStyle}" />
                                <StackPanel Margin="0,4,0,0"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="LocalInstallButton"
                                            Click="LocalInstall_Click"
                                            Content="安装 / 修复"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    <Button x:Name="LocalVerifyButton"
                                            Click="LocalVerify_Click"
                                            Content="校验" />
                                    <Button x:Name="LocalReloadButton"
                                            Click="LocalReload_Click"
                                            Content="重新载入" />
                                    <Button x:Name="LocalForceButton"
                                            Click="LocalForce_Click"
                                            Content="强制重新安装" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="LocalUninstallButton"
                                            Click="LocalUninstall_Click"
                                            Content="卸载全部本地模型" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="推荐 Hy-MT2 1.8B Q4_K_M 用于专业翻译（约 1.06 GiB）；Qwen3 1.7B 用于问答和文献整理。7B 版本体积和内存占用过高，因此桌面默认不提供。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                

                <!-- ============ AI 能力 ============ -->
                <TextBlock x:Name="SectionCapabilities" Text="AI 能力" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <InfoBar x:Name="CapabilitiesInfoBar" IsClosable="True" IsOpen="False" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="翻译" Style="{StaticResource CardTitleStyle}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="目标语言（保存到当前活动模型）" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="CapabilityLanguageBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="CapabilityLanguageBox_SelectionChanged">
                                        <ComboBoxItem Content="简体中文" />
                                        <ComboBoxItem Content="繁体中文" />
                                        <ComboBoxItem Content="英语" />
                                        <ComboBoxItem Content="日语" />
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox x:Name="PrefetchBox"
                                          Checked="PrefetchBox_Changed"
                                          Content="空闲时预翻译下一页"
                                          Unchecked="PrefetchBox_Changed" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="翻译类型（按学科领域定向语言与格式；“自动”跟随 AI 文献分析）" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="DomainPreferenceBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="DomainPreferenceBox_SelectionChanged" />
                                </StackPanel>
                                <CheckBox x:Name="LocalFallbackBox"
                                          Checked="LocalFallbackBox_Changed"
                                          Content="在线翻译失败时自动改用本地模型兜底"
                                          Unchecked="LocalFallbackBox_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="领域提示词" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="按学科领域定制翻译时追加的提示词；清空并保存即恢复内置默认。修改后相关页面会按新提示词自动重译。" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox x:Name="DomainHintPickerBox"
                                              MinWidth="200"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="DomainHintPickerBox_SelectionChanged" />
                                    <TextBlock x:Name="DomainHintStateText"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionStyle}" />
                                </StackPanel>
                                <TextBox x:Name="DomainHintTextBox"
                                         AcceptsReturn="True"
                                         MaxHeight="160"
                                         MinHeight="68"
                                         TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Click="DomainHintSave_Click"
                                            Content="保存"
                                            Style="{ThemeResource AccentButtonStyle}" />
                                    <Button Click="DomainHintReset_Click"
                                            Content="恢复默认" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="问答" Style="{StaticResource CardTitleStyle}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="问答使用的模型来源" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="AssistantSourceBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="AssistantSourceBox_SelectionChanged" />
                                </StackPanel>
                                <Button HorizontalAlignment="Left"
                                        Click="ClearAssistantHistory_Click"
                                        Content="清空问答历史" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="文献库整理" Style="{StaticResource CardTitleStyle}" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="整理使用的模型来源（本地离线或在线 API）" Style="{StaticResource CaptionStyle}" />
                                    <ComboBox x:Name="LibraryAnalysisSourceBox"
                                              MinWidth="280"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="LibraryAnalysisSourceBox_SelectionChanged" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoAnalysisToggle"
                                              IsOn="True"
                                              OffContent="不自动分析新文献"
                                              OnContent="自动分析新导入的文献"
                                              Toggled="AutoAnalysisToggle_Toggled" />
                                <TextBlock x:Name="PendingAnalysisText" Style="{StaticResource CaptionStyle}" />
                                <HyperlinkButton x:Name="InstallLocalModelLink"
                                                 HorizontalAlignment="Left"
                                                 Click="InstallLocalModelLink_Click"
                                                 Content="安装本地模型后自动开始" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="应用更新" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="CurrentVersionText" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="UpdateStatusText"
                                           Text="可手动检查 GitHub Releases 中的稳定版本。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionStyle}" />
                                <ProgressBar x:Name="UpdateProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CheckUpdateButton"
                                            Content="检查更新"
                                            Click="CheckUpdateButton_Click" />
                                    <Button x:Name="InstallUpdateButton"
                                            Content="下载并安装"
                                            Click="InstallUpdateButton_Click"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Visibility="Collapsed" />
                                </StackPanel>
                                <InfoBar x:Name="UpdateInfoBar" IsClosable="True" IsOpen="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                
                </StackPanel>
</ScrollViewer>
    </Grid>
</UserControl>
