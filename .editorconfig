root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,slnx,xaml,ps1,iss}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.{cpp,h}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,html,css,js,svg}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
